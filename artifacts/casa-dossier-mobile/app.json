{
  "expo": {
    "name": "Casa Dossier",
    "slug": "casa-dossier-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "casa-dossier-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F8F6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.casadossier.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.casadossier.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "modularHeaders": true
          }
        }
      ],
      "./plugins/withModularHeaders",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3d7a5f",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Casa Dossier uses your photo library so you can attach photos of your home, appliances, receipts and warranty documents to your records.",
          "cameraPermission": "Casa Dossier uses the camera so you can photograph appliances, model plates, receipts and documents to add them to your home's records.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Casa Dossier uses the camera to scan equipment QR labels and to photograph appliances, model plates, receipts and documents for your home's records.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ad4f5679-e6b1-498f-84a5-32cbc8c293bb"
      }
    }
  }
}
