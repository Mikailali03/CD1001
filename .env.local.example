# Local dev environment for scripts/dev-local.sh.
# Copy to .env.local (gitignored) and fill in the secrets from the Replit Secrets pane.

# --- Required to boot ---
DATABASE_URL=postgres://localhost:5432/casa_dossier

# --- AI (optional) ---
# Without a key the API still boots; AI scans and plans answer 503.
# OPENAI_BASE_URL is only needed for a proxy or compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- File storage ---
# Locally, uploads are stored on disk under LOCAL_STORAGE_DIR (default ./.local-storage
# in the API's working directory) and PUT through the API. Set STORAGE_DRIVER=gcs with
# GOOGLE_APPLICATION_CREDENTIALS (or GCS_CREDENTIALS_JSON) to use a real GCS bucket;
# then also set PRIVATE_OBJECT_DIR=/<bucket>/private and PUBLIC_OBJECT_SEARCH_PATHS=/<bucket>/public.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=

# --- Auth (Clerk dev instance; works on localhost) ---
CLERK_PUBLISHABLE_KEY=pk_test_bG95YWwtbGFicmFkb3ItOTQuY2xlcmsuYWNjb3VudHMuZGV2JA
VITE_CLERK_PUBLISHABLE_KEY=pk_test_bG95YWwtbGFicmFkb3ItOTQuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=
ADMIN_EMAIL=mikailali03@gmail.com

# --- Optional; features degrade without them ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: without it, emails are skipped locally (on Replit the Resend integration is used).
RESEND_API_KEY=
EMAIL_FROM="Casa Dossier <no-reply@notifications.casadossier.com>"
# Optional: tech portal map tiles (the map shows a warning without it).
CARTO_API_KEY=
RENTCAST_API_KEY=
# App-wide daily cap on user-triggered RentCast calls (default 1000).
RENTCAST_DAILY_LIMIT=
# Read-only demo at /demo. Off unless both are set to the same value.
DEMO_TOKEN=
VITE_DEMO_TOKEN=
SCHEDULE_TIMEZONE=America/New_York
# CasaService area: <lat>,<lng>,<radiusMiles>[,<name>]
SERVICE_AREA=33.749,-84.388,50,Atlanta area
LOG_LEVEL=info
